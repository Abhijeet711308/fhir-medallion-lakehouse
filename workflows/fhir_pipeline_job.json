{
  "name": "fhir_medallion_pipeline",
  "description": "Patient -> Encounter -> Observation -> Condition, then silver (SCD2), gold and checks",
  "git_source": {
    "git_url": "https://github.com/Abhijeet711308/fhir-medallion-lakehouse",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "max_concurrent_runs": 1,
  "parameters": [
    {
      "name": "start_date",
      "default": ""
    },
    {
      "name": "end_date",
      "default": ""
    },
    {
      "name": "payload_format",
      "default": "json"
    },
    {
      "name": "config_path",
      "default": ""
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 30 2 * * ?",
    "timezone_id": "Asia/Kolkata",
    "pause_status": "PAUSED"
  },
  "tasks": [
    {
      "task_key": "setup",
      "description": "Create schemas, raw volume and metadata tables",
      "notebook_task": {
        "notebook_path": "notebooks/00_setup",
        "source": "GIT",
        "base_parameters": {
          "config_path": "{{job.parameters.config_path}}"
        }
      }
    },
    {
      "task_key": "ingest_patient",
      "description": "API -> raw files -> bronze for Patient",
      "depends_on": [
        {
          "task_key": "setup"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/01_ingest_resource",
        "source": "GIT",
        "base_parameters": {
          "config_path": "{{job.parameters.config_path}}",
          "resource": "Patient",
          "run_id": "{{job.run_id}}",
          "start_date": "{{job.parameters.start_date}}",
          "end_date": "{{job.parameters.end_date}}",
          "payload_format": "{{job.parameters.payload_format}}"
        }
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "ingest_encounter",
      "description": "API -> raw files -> bronze for Encounter",
      "depends_on": [
        {
          "task_key": "ingest_patient"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/01_ingest_resource",
        "source": "GIT",
        "base_parameters": {
          "config_path": "{{job.parameters.config_path}}",
          "resource": "Encounter",
          "run_id": "{{job.run_id}}",
          "start_date": "{{job.parameters.start_date}}",
          "end_date": "{{job.parameters.end_date}}",
          "payload_format": "{{job.parameters.payload_format}}"
        }
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "ingest_observation",
      "description": "API -> raw files -> bronze for Observation",
      "depends_on": [
        {
          "task_key": "ingest_encounter"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/01_ingest_resource",
        "source": "GIT",
        "base_parameters": {
          "config_path": "{{job.parameters.config_path}}",
          "resource": "Observation",
          "run_id": "{{job.run_id}}",
          "start_date": "{{job.parameters.start_date}}",
          "end_date": "{{job.parameters.end_date}}",
          "payload_format": "{{job.parameters.payload_format}}"
        }
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "ingest_condition",
      "description": "API -> raw files -> bronze for Condition",
      "depends_on": [
        {
          "task_key": "ingest_observation"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/01_ingest_resource",
        "source": "GIT",
        "base_parameters": {
          "config_path": "{{job.parameters.config_path}}",
          "resource": "Condition",
          "run_id": "{{job.run_id}}",
          "start_date": "{{job.parameters.start_date}}",
          "end_date": "{{job.parameters.end_date}}",
          "payload_format": "{{job.parameters.payload_format}}"
        }
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "silver_patient",
      "description": "Parse, clean and apply SCD2 for Patient",
      "depends_on": [
        {
          "task_key": "ingest_patient"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_silver_resource",
        "source": "GIT",
        "base_parameters": {
          "config_path": "{{job.parameters.config_path}}",
          "resource": "Patient",
          "run_id": "{{job.run_id}}"
        }
      }
    },
    {
      "task_key": "silver_encounter",
      "description": "Parse, clean and apply SCD2 for Encounter",
      "depends_on": [
        {
          "task_key": "ingest_encounter"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_silver_resource",
        "source": "GIT",
        "base_parameters": {
          "config_path": "{{job.parameters.config_path}}",
          "resource": "Encounter",
          "run_id": "{{job.run_id}}"
        }
      }
    },
    {
      "task_key": "silver_observation",
      "description": "Parse, clean and apply SCD2 for Observation",
      "depends_on": [
        {
          "task_key": "ingest_observation"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_silver_resource",
        "source": "GIT",
        "base_parameters": {
          "config_path": "{{job.parameters.config_path}}",
          "resource": "Observation",
          "run_id": "{{job.run_id}}"
        }
      }
    },
    {
      "task_key": "silver_condition",
      "description": "Parse, clean and apply SCD2 for Condition",
      "depends_on": [
        {
          "task_key": "ingest_condition"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_silver_resource",
        "source": "GIT",
        "base_parameters": {
          "config_path": "{{job.parameters.config_path}}",
          "resource": "Condition",
          "run_id": "{{job.run_id}}"
        }
      }
    },
    {
      "task_key": "gold",
      "description": "Reporting views and dim_date",
      "depends_on": [
        {
          "task_key": "silver_patient"
        },
        {
          "task_key": "silver_encounter"
        },
        {
          "task_key": "silver_observation"
        },
        {
          "task_key": "silver_condition"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/03_gold",
        "source": "GIT",
        "base_parameters": {
          "config_path": "{{job.parameters.config_path}}",
          "run_id": "{{job.run_id}}"
        }
      }
    },
    {
      "task_key": "validation",
      "description": "Counts and SCD2 checks",
      "depends_on": [
        {
          "task_key": "gold"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/04_validation",
        "source": "GIT",
        "base_parameters": {
          "config_path": "{{job.parameters.config_path}}"
        }
      }
    }
  ]
}